   "source": [
    "#矩阵点积运算规则\n",
    "import numpy as np\n",
    "a=np.array([[1,2,3],[4,5,6]])#2行3列\n",
    "b=np.array([[1,2],[3,4],[5,6]])#3行2列\n",
    "c=np.dot(a,b)\n",
    "print(a)\n",
    "print(b)\n",
    "print(c)#若不满足m×n与n×k的形状，会报错"
   ]
  },
  {
