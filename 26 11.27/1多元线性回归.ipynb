      "[1 2 3]\n"
     ]
    }
   ],
   "source": [
    "#矩阵的转置\n",
    "#第i行=》第i列\n",
    "print(a.T)\n",
    "#一维时，情况有变化\n",
    "d=np.array([1,2,3])\n",
    "print(d)\n",
    "print(d.T)#一维时，不存在行向量变列向量，即转置不会改变维度数\n"
   ]
  }
